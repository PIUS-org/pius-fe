# ─────────────────────────────────────────────────────────────
# pius-fe 환경변수
#
# 환경별 파일이 저장소에 함께 들어 있으므로 별도 설정 없이 실행된다.
#   .env.docker       로컬 (npm run dev:docker)
#   .env.development  개발 서버
#   .env.production   운영
#
# 개인 설정으로 덮어쓰려면 .env.local 을 만든다 (커밋되지 않음).
# ─────────────────────────────────────────────────────────────

# 실행 환경: docker | dev | prod
NEXT_PUBLIC_APP_ENV=docker

# 브라우저에서 호출하는 백엔드 주소
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Next 서버(BFF Route Handler)가 호출하는 백엔드 주소
API_INTERNAL_URL=http://localhost:8080/api/v1
