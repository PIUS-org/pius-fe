# 배포 빌드용 (Vercel).
#
# Vercel 프로젝트에 설정한 환경변수가 이 파일보다 우선한다. 실제 배포는 그쪽 값을 쓰고,
# 이 파일은 로컬에서 `npm run build` 로 배포 빌드를 재현할 때의 기본값이다.
#
# NEXT_PUBLIC_API_BASE_URL 은 빌드 타임에 클라이언트 번들에 문자열로 박힌다.
# 값이 바뀌면 런타임 설정이 아니라 재빌드가 필요하다.
NEXT_PUBLIC_APP_ENV=dev
NEXT_PUBLIC_API_BASE_URL=https://api.pius.co.kr/api/v1
API_INTERNAL_URL=https://api.pius.co.kr/api/v1
